config BOARD_LOFREE_EDGE
    select SOC_TLSR8278

config LOFREE_EDGE_SWITCH_DIAGNOSTICS
    bool "Observe Edge candidate switch inputs (no automatic switching)"
    depends on BOARD_LOFREE_EDGE
    default n
    help
      Enable only PD5-PD7 inputs, with outputs disabled and pulls unchanged,
      as corroborated by stock initialization. Expose levels through the
      read-only board status report. Physical switch roles remain unverified.
